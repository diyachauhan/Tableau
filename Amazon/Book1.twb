      <aliases enabled='yes' />
      <column caption='&quot;Order Id&quot;' datatype='string' name='[&quot;order_id&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Answer Timestamp&quot;' datatype='datetime' name='[&quot;review_answer_timestamp&quot;]' role='dimension' type='ordinal' />
      <column caption='&quot;Review Comment Message&quot;' datatype='string' name='[&quot;review_comment_message&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Comment Title&quot;' datatype='string' name='[&quot;review_comment_title&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Creation Date&quot;' datatype='string' name='[&quot;review_creation_date&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Id&quot;' datatype='string' name='[&quot;review_id&quot;]' role='dimension' type='nominal' />
      <column caption='&quot;Review Score&quot;' datatype='integer' name='[&quot;review_score&quot;]' role='measure' type='quantitative' />
      <column caption='Net Revenue' datatype='real' name='[Calculation_2236600212680114176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([payment_value]) - SUM([price] * 0.05)' />
      </column>
      <column caption='Refund Liability Rate' datatype='real' name='[Calculation_2236600212680216577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [seller_id] : &#13;&#10;  SUM([price] * 0.05) / SUM([payment_value]) &#13;&#10;}' />
      </column>
      <column caption='Gross Margin %' datatype='real' name='[Calculation_2236600212680372226]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([payment_value] - [freight_value] - ([price] * 0.05)) &#13;&#10;/ [payment_value]' />
      </column>
      <column caption='Revenue Leakage Flag' datatype='string' name='[Calculation_2236600212680495107]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF(&#13;&#10;  AVG([Calculation_2236600212680216577]) &gt; 0.10&#13;&#10;  AND SUM([payment_value]) &gt; 10000,&#13;&#10;  &apos;HIGH RISK&apos;, &apos;OK&apos;&#13;&#10;)' />
      </column>
      <column caption='Low Review Flag' datatype='integer' name='[Calculation_2236600212680613892]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([&quot;review_score&quot;]&lt;= 2,1,0)' />
      </column>
